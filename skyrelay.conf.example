# ============================================================================
#  SkyRelay - Konfiguration
# ============================================================================
#  Diese Datei nach "skyrelay.conf" kopieren und anpassen:
#      cp skyrelay.conf.example skyrelay.conf
#
#  Die eigene skyrelay.conf gehört NICHT ins Repository (steht in .gitignore).
#  Das Bluesky-App-Passwort steht bewusst NICHT hier, sondern in der
#  Umgebungsvariablen BLUESKY_TICKER_APP_PASSWORD bzw. BLUESKY_FEED_APP_PASSWORD.
#
#  Ein anderer Pfad lässt sich über die Umgebungsvariable SKYRELAY_CONFIG
#  angeben - so lassen sich mehrere Vereine parallel betreiben.
# ============================================================================

[bluesky]
# Handle des Bot-Kontos, auf dem gepostet wird.
handle = dein-bot.bsky.social


[source]
# Einladungslink des WhatsApp-Kanals, der gespiegelt werden soll.
# Im Handy: Kanal öffnen -> Kanalnamen antippen -> Teilen -> Link kopieren.
channel_invite_link = https://whatsapp.com/channel/HIER-DEN-KANAL-LINK-EINSETZEN


[team]
# Suchbegriff für die OpenLigaDB-Abfrage (Teil des Vereinsnamens).
# LEER LASSEN, wenn es für die Sportart keine Daten bei OpenLigaDB gibt
# (z.B. Basketball oder Handball-Ligabetrieb): Dann entfällt die
# Spieltags-Erkennung, der Ticker läuft an jedem Tag, an dem er gestartet
# wird, und der Spiel-Hashtag kommt aus SKYRELAY_HASHTAG.
# Gepflegt sind bei OpenLigaDB vor allem Fußball (1.-3. Liga, DFB-Pokal,
# Frauen-Bundesliga) und Eishockey (DEL, DEL2).
openligadb_filter = bielefeld
# Team-Nummer bei OpenLigaDB (0 = keine Spieltags-Erkennung). Zur
# Absicherung, weil der Suchbegriff auch fremde Vereine treffen kann.
# Nachschlagen: https://api.openligadb.de/getavailableteams/bl2/2026
openligadb_team_id = 83
# Nur Spiele aus diesen Ligen zählen - EXAKTE Ligakürzel als Komma-Liste,
# z.B. "bl2, dfb, rlw-frauen". Groß-/Kleinschreibung ist egal.
# Hintergrund: OpenLigaDB liefert vereinzelt Fantasie-Ligen mit falschen
# Terminen (real gesehen: "ESP8266"). Ohne diese Sperre würde der Bot an
# spielfreien Tagen anspringen.
# Hier lassen sich auch mehrere Mannschaften eines Vereins abdecken: trägt die
# zweite Mannschaft bei OpenLigaDB dieselbe Team-Nummer, genügt es, ihre Liga zu
# ergänzen. Spielen dann beide am selben Tag, greift [post] overlap_hashtag.
# Leer lassen = kein Filter (dann zählt jede Liga, auch erfundene).
# Welche Kürzel wirklich vorkommen, nennt der Ticker beim Start im Protokoll.
league_shortcuts =
# VERALTET, bitte auf league_shortcuts umstellen: Dieser Schlüssel verglich
# PRÄFIXE. Damit passierte "bl2h" die Prüfung, weil es mit "bl" anfängt - und
# dieselbe Partie tauchte an einem zweiten, falschen Tag auf. Solange
# league_shortcuts leer ist, gilt weiterhin dieser Wert.
league_prefixes = bl, dfb
# Zeitzone für Anstoßzeiten und das Tagesende.
timezone = Europe/Berlin


[team_codes]
# Kürzel für die Hashtag-Bildung: Heimteam + Auswärtsteam ergibt z.B. #KSCDSC.
# Format:  <OpenLigaDB-Team-Nummer> = <Kürzel>
# Fehlt ein Gegner, nimmt der Bot die ersten drei Buchstaben des Kurznamens und
# schreibt eine Warnung ins Protokoll - dann hier ergänzen.
# Am einfachsten füllt skyrelay-setup.py diese Tabelle für die ganze Liga.
# Stand: 2. Bundesliga 2026/27.
83 = DSC
199 = FCH
76 = FCK
78 = FCM
79 = FCN
177 = SGD
74 = EBS
93 = FCE
98 = STP
55 = H96
54 = BSC
104 = KSV
105 = KSC
115 = SGF
118 = SVD
129 = BOC
36 = OSN
131 = WOB


[post]
# Ob die Kopfzeile ueberhaupt erscheint:
#   always  immer (Vorgabe - so hat SkyRelay es immer gemacht)
#   never   nie
#   auto    nur, solange die Profilbeschreibung den Hinweis nicht selbst traegt
# Bei "auto" wird die Beschreibung des Bot-Kontos einmal je Lauf geprueft. Die
# eigene Statuszeile ([profile] marker) wird dabei uebergangen - sonst faende
# sich "Bot" immer, naemlich im selbst geschriebenen "Bot ist an".
bot_notice = always
# Wonach in der Beschreibung gesucht wird.
bot_notice_marker = Bot
# Kopfzeile jedes Hauptbeitrags. Kennzeichnet den Bot als inoffiziell -
# bitte drin lassen, das erspart Missverständnisse.
# Leer lassen, um ganz auf die Kopfzeile zu verzichten.
prefix = ⚽ [Inoffizieller Bot]
# Wie die Quellenangabe aussieht und welcher Teil davon der Link ist.
# Der Teil in [eckigen Klammern] wird zum Link, {label} steht für die
# Beschriftung darunter. Gilt für Ticker UND Feed - das Wort "Quelle" ist in
# beiden Fällen dasselbe, verschieden ist nur, worauf es zeigt.
#   🔗 [Quelle]: {label}   das Wort Quelle ist der Link (Vorgabe)
#   🔗 [Quelle]            nur das Wort, ohne Beschriftung - spart Zeichen
#   🔗 Quelle: [{label}]   die Beschriftung ist der Link (bis Version 1.3 so)
source_template = 🔗 [Quelle]: {label}
# Beschriftung des Quell-Links (verweist auf den Kanal aus [source]).
# Leer lassen, um die Quellenangabe wegzulassen.
# ACHTUNG: Leer lassen heißt "source_label =" ohne Wert. Die Zeile
# AUSZUKOMMENTIEREN bewirkt etwas anderes - dann greift die Vorgabe aus dem
# Programm, und die Quelle steht weiterhin im Beitrag. Was gerade gilt, zeigt
#   venv/bin/python skyrelay-matchday.py --show-config
source_label = WhatsApp-Kanal des Vereins
# Hashtag, der unter jedem Beitrag steht (ohne #). Leer lassen für keinen.
standing_hashtag = arminia
# Spielen an einem Tag mehrere Mannschaften des Vereins (z.B. Herren und
# Frauen), laesst sich einer Kanal-Nachricht nicht ansehen, zu welcher Partie
# sie gehoert. Statt falsch zu beschriften, tritt dieser Hashtag an die Stelle
# der Spiel-Hashtags; die Profilzeile nennt weiterhin beide Partien.
# Leer lassen, um an solchen Tagen gar keinen Spiel-Hashtag zu setzen.
overlap_hashtag = immerdabei
# Platzhaltertexte, wenn ein Beitrag nur aus Medien ohne Text besteht.
image_placeholder = 📸 Neues Bild im Kanal
video_placeholder = 🎥 Neues Video im Kanal
# Hinweis, der angehängt wird, wenn ein Video nicht übertragen werden konnte.
video_hint = 🎥 (Video im Original-Kanal)
# Platzhaltertexte fuer Nachrichten, die nur aus einer Sprachnachricht bzw.
# einem Sticker bestehen - beides kommt im Kanal fast immer ohne Text.
audio_placeholder = 🔊 Neue Sprachnachricht im Kanal
sticker_placeholder = ✨ Neuer Sticker im Kanal
# Präfix der hochgeladenen Videodateien (nur intern sichtbar).
media_prefix = skyrelay
# Text der Antwort, mit der ein zunaechst gescheitertes Video nachgereicht wird.
video_retry_text = 🎥 Nachgereicht: das Video zum Beitrag oben.


[layout]
# ---------------------------------------------------------------------------
#  Wo die Bausteine eines Beitrags stehen. Eine Zeile je Baustein:
#
#      baustein = <Beiträge> ; <Stelle> ; <Reihenfolge>
#
#  Beiträge:     first  nur der erste Beitrag des Threads
#                last   nur der letzte
#                all    jeder Beitrag
#                none   gar nicht
#  Stelle:       top    über dem Text        bottom  unter dem Text
#  Reihenfolge:  Zahl - entscheidet, was zuerst kommt, wenn zwei Bausteine
#                an derselben Stelle landen.
#
#  Die Vorgaben unten erzeugen genau das Aussehen, das SkyRelay immer hatte.
#  Einen Baustein ganz weglassen geht auf zwei Wegen: hier "none" eintragen,
#  oder seinen Inhalt leer lassen (z.B. [post] source_label).
#  Wie das Ergebnis aussieht, zeigt ein Trockenlauf:
#      SKYRELAY_DRY_RUN=1 SKYRELAY_FORCE=1 SKYRELAY_REPLAY=1 #          venv/bin/python skyrelay-matchday.py
# ---------------------------------------------------------------------------
# Die Kopfzeile aus [post] prefix.
prefix = first ; top ; 1
# Der Quell-Link (Beschriftung aus [post] source_label bzw. [feed] source_label).
source = first ; top ; 2
# Der aus dem Spielplan gebildete Hashtag - nur der Ticker hat einen.
match_hashtag = last ; bottom ; 1
# Der Dauer-Hashtag aus [post] standing_hashtag.
standing_hashtag = last ; bottom ; 2


[audio]
# ---------------------------------------------------------------------------
#  Sprachnachrichten aus dem WhatsApp-Kanal.
#  Bluesky kennt kein Audio-Format. SkyRelay macht aus einer Sprachnachricht
#  deshalb ein Video mit animierter Wellenform - der Ton bleibt erhalten.
#  Setzt ffmpeg auf dem System voraus.
# ---------------------------------------------------------------------------
# Kantenlaenge des erzeugten Videos. Kostet spuerbar Rechenzeit: auf einem
# Raspberry Pi brauchte eine 8-Sekunden-Sprachnachricht gemessen
#   720x720 @25 fps -> 11,0 s und 1401 KB
#   720x720 @15 fps ->  7,1 s und 1265 KB
#   480x480 @25 fps ->  4,6 s und  759 KB
# Am Spieltag zaehlt Zeit - 480x480 ist der beste Tausch, eine Wellenform
# hat keine feinen Details, die unter der kleineren Aufloesung litten.
size = 720x720
# Bilder je Sekunde. Weniger ist schneller, laesst die Welle aber hakeln.
framerate = 25
# Farbe der Wellenform.
# ACHTUNG: Hier geht NUR ein ffmpeg-Farbname, etwa White, DodgerBlue, Cyan,
# Gold, Orange. Eine Hex-Angabe wie 0x38BDF8 oder #38BDF8 verwirft ffmpeg
# stillschweigend und zeichnet gruen - ohne jede Fehlermeldung. SkyRelay warnt
# im Protokoll, wenn hier etwas mit 0x oder # steht.
waveform_color = White
# Hintergrund des Videos. Hier ist Hex erlaubt (0xRRGGBB) oder ein Farbname.
background_color = 0x0b1220
# Hintergrund, auf den transparente Sticker gelegt werden. Ohne das staende
# das Motiv auf Schwarz, weil beim Verwerfen der Transparenz nichts bleibt.
sticker_background = white


[feed]
# ---------------------------------------------------------------------------
#  Nur für skyrelay-feed.py (Instagram -> Bluesky, Dauerbetrieb).
#  Wer nur den Spieltags-Ticker nutzt, kann diesen Abschnitt ignorieren.
# ---------------------------------------------------------------------------
# Bluesky-Konto für die Instagram-Spiegelung. Leer lassen, um das Konto aus
# [bluesky] zu verwenden. Bei einem eigenen Konto braucht es auch ein eigenes
# App-Passwort - dann BLUESKY_FEED_APP_PASSWORD setzen (und für den Ticker
# entsprechend BLUESKY_TICKER_APP_PASSWORD).
bluesky_handle =
# Instagram-Profil, das gespiegelt wird (ohne @).
instagram_profile = arminiaofficial
# Zweitkonto, mit dem abgerufen wird. Sitzung einmalig anlegen mit:
#   venv/bin/instaloader -l <zweitkonto>
instagram_session_user = dein_zweitkonto
# Beschriftung des Quell-Links unter jedem Beitrag. Eigener Wert, weil
# [post] source_label den WhatsApp-Kanal des Tickers beschreibt.
# Leer lassen, um die Quellenangabe wegzulassen (siehe Hinweis bei [post]).
source_label = Beitrag auf Instagram
# Wie viele der letzten Beiträge je Lauf geprüft werden. Mehr als 5, damit
# angeheftete Beiträge keine neuen verdrängen.
posts_to_check = 10
# Pause zwischen zwei Bluesky-Beiträgen (Sekunden).
pause_between_posts_seconds = 8
# Texte, wenn ein Instagram-Beitrag keinen eigenen Text hat.
video_placeholder = 🎥 Neues Video/Reel
mixed_placeholder = 📸🎥 Neuer Beitrag
image_placeholder = 📸 Neues Bild
# Ersatz für die Bildbeschreibung (Barrierefreiheit), wenn kein Text da ist.
alt_text_fallback = News
# Text der Folgebeiträge, wenn ein Instagram-Beitrag mehr Medien als Text hat
# (z.B. ein Karussell mit mehreren Videos, aber nur einer kurzen Bildunterschrift).
continuation_text = Weitere Inhalte...
# Merkliste bereits übernommener Beiträge und eigene Protokolldatei.
state = skyrelay_feed_posted.txt
log = skyrelay-feed.log


[profile]
# Nur für skyrelay-matchday.py.
# Erste Zeile der Bluesky-Biografie am Spieltag umschalten? true/false
enabled = true
# Woran eine bereits vorhandene Statuszeile erkannt wird: Enthält die erste
# Zeile diesen Text, wird sie ersetzt - sonst wird die Zeile davorgesetzt.
marker = Bot ist
# Platzhalter: {info} = "1. Spieltag" bzw. "DFB-Pokal, 1. Runde"
#              {hashtag} = "#KSCDSC", {date} = "08.08.", {time} = "13:00"
line_on = 🟢 Bot ist an - {info} {hashtag} ⚫⚪🔵
line_off = 🔴 Bot ist aus - nächstes Spiel {hashtag} ⚫⚪🔵
line_off_no_match = 🔴 Bot ist aus ⚫⚪🔵
# Text für {info}, wenn OpenLigaDB kein Spiel kennt (z.B. Testspiele).
fallback_match_info = Testspiel


[schedule]
# Bis wann an Spieltagen gelauscht wird (danach beendet sich der Bot selbst).
day_end = 23:59
# Abstand, in dem das Live-Abo des Kanals erneuert wird (Sekunden).
subscribe_renew_seconds = 240
# Pause zwischen zwei Bluesky-Beiträgen (Sekunden).
pause_between_posts_seconds = 3


[files]
# Dateinamen im Programmverzeichnis. Beim Umbenennen einer bestehenden
# Installation werden vorhandene Dateien automatisch übernommen.
# ACHTUNG: session enthält die WhatsApp-Kopplung - niemals weitergeben.
session = skyrelay_session.sqlite3
state = skyrelay_state.txt
posts_map = skyrelay_posts.json
log = skyrelay.log
# Ordner fuer Videos, deren Upload scheiterte und die nachgereicht werden.
video_retry_dir = skyrelay_nachreichen


[logging]
# Protokoll immer zusätzlich in die Datei aus [files] log schreiben.
to_file = true
# Ab dieser Größe wird beim Start rotiert (Bytes), mit so vielen Sicherungen.
max_bytes = 2000000
backup_count = 5


[limits]
# Grenzwerte von Bluesky bzw. Wartezeiten - normalerweise unverändert lassen.
max_video_bytes = 100000000
video_job_timeout_seconds = 600
# So oft wird ein gescheitertes Video in spaeteren Laeufen erneut versucht,
# danach wird es verworfen (der Beitrag bleibt dann beim Vorschaubild).
video_retry_max_attempts = 8
# Takt, in dem der Ticker im Lauschbetrieb offene Videos erneut versucht.
video_retry_interval_seconds = 600
