msgid "Bis zu dieser Uhrzeit lauscht der Ticker, danach beendet er sich selbst."
msgstr "The ticker listens until this time, then stops by itself."

#: skyrelay-setup.py:594
msgid "2 von 2: "
msgstr "2 of 2: "

#: skyrelay-setup.py:595
msgid "läuft im Dauerbetrieb"
msgstr "runs all year round"

#: skyrelay-setup.py:597
msgid "Instagram-Profil (Quelle des Feeds)"
msgstr "Instagram profile (the feed's source)"

#: skyrelay-setup.py:598
msgid "Profil, das gespiegelt wird (ohne @)"
msgstr "The profile being mirrored (without @)"

#: skyrelay-setup.py:602
msgid "Zweitkonto für den Abruf - NICHT das gespiegelte Profil."
msgstr "A secondary account used to fetch - NOT the profile being mirrored."

#: skyrelay-setup.py:603
msgid "Sitzung anlegen mit: venv/bin/instaloader -l <name>"
msgstr "Create the session with: venv/bin/instaloader -l <name>"

